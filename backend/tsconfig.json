{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"],
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "scripts/**/*", "test/**/*", "vitest.config.ts", "types/**/*.d.ts"]
}

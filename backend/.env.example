# Backend server port
PORT=5000

# Frontend origin allowed by Socket.IO CORS
CLIENT_URL=http://localhost:3000

# MongoDB connection string (required to start the backend)
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017/linko

# Replace with a long, random secret before running outside local development
ACCESS_TOKEN_SECRET=replace-this-with-a-long-random-secret

# Local environment; the demo seeder refuses to run when this is production
NODE_ENV=development

# Cloudflare R2 (replace every example value before uploading files)
# Create a token with object read/write/delete permissions for both buckets.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BUCKET_NAME=linko-public-media
R2_PRIVATE_BUCKET_NAME=linko-private-attachments
# Public media bucket custom domain; r2.dev is suitable only for local development
R2_PUBLIC_BASE_URL=https://media.example.com

# Backend server port
PORT=5000

# Frontend origin allowed by Socket.IO CORS
CLIENT_URL=http://localhost:3000

# MongoDB connection string (required to start the backend)
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017/linko

# Replace with a long, random secret before running outside local development
ACCESS_TOKEN_SECRET=replace-this-with-a-long-random-secret

# Cloudflare R2 storage (required for new profile image and message attachment uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
# Public custom domain for the public media bucket; use r2.dev only for local development
R2_PUBLIC_BASE_URL=

# Legacy cleanup credentials; required only while MongoDB still contains Cloudinary image IDs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

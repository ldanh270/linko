# Public backend URL for HTTP requests and Socket.IO
# In local development, defaults to http://localhost:5000 if not set.
# In production (e.g. Vercel), set this to your deployed Render backend URL:
# NEXT_PUBLIC_API_URL=https://linko-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional map provider. Keep visible attribution appropriate for the selected provider.
# Default public OSM tiles are best-effort; review their usage policy for deployment traffic.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

{
  "name": "linko",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"nr dev:backend\" \"nr dev:frontend\"",
    "dev:backend": "nr -C backend dev",
    "dev:frontend": "nr -C frontend dev",
    "i:all": "ni && nr i:backend && nr i:frontend",
    "i:backend": "ni -C backend",
    "i:frontend": "ni -C frontend",
    "build": "nr build:frontend",
    "build:frontend": "nr -C frontend build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

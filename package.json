{
  "name": "linko",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"pnpm run be:dev\" \"pnpm run fe:dev\"",
    "fe:install": "ni -C frontend",
    "fe:dev": "pnpm -C frontend dev",
    "fe:build": "pnpm -C frontend build",
    "fe:start": "pnpm -C frontend start",
    "fe:lint": "pnpm -C frontend lint",
    "fe:test": "pnpm -C frontend test",
    "fe:typecheck": "pnpm -C frontend typecheck",
    "be:install": "ni -C backend",
    "be:dev": "pnpm -C backend dev",
    "be:start": "pnpm -C backend start",
    "be:build": "pnpm -C backend typecheck",
    "be:lint": "pnpm -C backend lint",
    "be:test": "pnpm -C backend test",
    "be:typecheck": "pnpm -C backend typecheck",
    "db:status": "pnpm -C backend db:status",
    "db:shell": "pnpm -C backend db:shell",
    "db:clear": "pnpm -C backend db:clear",
    "db:seed": "pnpm -C backend db:seed",
    "db:migrate:audit": "pnpm -C backend db:migrate:audit",
    "db:migrate:notifications": "pnpm -C backend db:migrate:notifications",
    "dev:backend": "pnpm run be:dev",
    "dev:frontend": "pnpm run fe:dev",
    "seed": "pnpm run db:seed",
    "i:all": "ni && pnpm run be:install && pnpm run fe:install",
    "i:backend": "pnpm run be:install",
    "i:frontend": "pnpm run fe:install",
    "build": "pnpm run be:build && pnpm run fe:build",
    "build:frontend": "pnpm run fe:build",
    "lint": "pnpm run be:lint && pnpm run fe:lint",
    "typecheck": "pnpm run be:typecheck && pnpm run fe:typecheck",
    "test": "pnpm run be:test && pnpm run fe:test"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "concurrently": "^9.2.1"
  }
}
